meta {
  name: Edit Quiz
  type: http
  seq: 7
}

put {
  url: {{base_url}}/quiz/{{quizzid}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{quizzname}}",
    "tag_id": {{tag_id}}
  }
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
    
  bru.setEnvVar("quizzname",faker.string.alphanumeric({}));
  bru.setEnvVar("tag_id",faker.number.int({max: 3, min: 1}));
}

tests {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
}
