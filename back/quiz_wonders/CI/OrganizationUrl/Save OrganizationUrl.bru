meta {
  name: Save OrganizationUrl
  type: http
  seq: 4
}

put {
  url: {{base_url}}/organization-url/{{organisationurlid}}
  body: json
  auth: none
}

body:json {
  {
    "url": "{{organisationurl}}",
    "organization_id": {{organisationid}},
    "rank": 2,
    "partner": "{{organisationpartner}}",
    "status_id": 2,
    "key": "ts"
  }
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  bru.setEnvVar("organisationid",faker.number.int({max: 3, min: 1}));
  bru.setEnvVar("organisationurl",faker.internet.url());
  bru.setEnvVar("organisationpartner",faker.person.firstName());
}

tests {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  const response = res.getBody();
  
  bru.setEnvVar("organisationurlid", response.id);
}
