}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  bru.setEnvVar("Id", faker.number.int({max : 5, min : 1}))
}

tests {
  test("Status code is 204", function () {
      expect(res.getStatus()).to.equal(204);
  });
}
