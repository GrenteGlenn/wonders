meta {
  name: Edit TripCity
  type: http
  seq: 4
}

put {
  url: {{base_url}}/trip-city/{{tripcityid}}
  body: json
  auth: inherit
}

body:json {
  {
    "trip_id": {{trip_id}},
    "city_id": {{city_id}},
    "transportation_id": {{transportation_id}}
  }
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  bru.setEnvVar("trip_id",faker.number.int({max: 3, min: 1}))
  bru.setEnvVar("city_id",faker.number.int({max: 10, min: 1}))
  bru.setEnvVar("transportation_id",faker.number.int({max: 3, min: 1}))
}

tests {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
}
