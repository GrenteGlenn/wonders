meta {
  name: Save TripDay
  type: http
  seq: 1
}

post {
  url: {{base_url}}/trip-day/
  body: json
  auth: none
}

params:path {
  id: 1
}

body:json {
  {
    "trip_city_id": {{trip_city_id}},
    "date": {{date}}
  }
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  bru.setEnvVar("trip_city_id",faker.number.int({max: 10, min: 1}))
  bru.setEnvVar("date",faker.date.soon())
}

tests {
  test("Status code is 201", function () {
      expect(res.getStatus()).to.equal(201);
  });
  
  const response = res.getBody();
  
  bru.setEnvVar("tripdayid", response.id);
}
