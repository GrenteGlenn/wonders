meta {
  name: Edit TripDayActivity
  type: http
  seq: 4
}

put {
  url: {{base_url}}/trip-day-activity/{{tripdayactivityid}}
  body: json
  auth: inherit
}

body:json {
  {
    "trip_day_id": {{trip_day_id}},
    "activity_id": {{activity_id}},
    "status": "APayer"
  }
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  bru.setEnvVar("trip_day_id",faker.number.int({max: 10, min: 1}))
  bru.setEnvVar("activity_id",faker.number.int({max: 10, min: 1}))
}

tests {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
}
