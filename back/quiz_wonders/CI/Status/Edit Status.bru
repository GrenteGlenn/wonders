meta {
  name: Edit Status
  type: http
  seq: 4
}

put {
  url: {{base_url}}/status/{{statusid}}
  body: json
  auth: inherit
}

body:json {
  {
    "name": "{{name}}"
  }
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
    
  bru.setEnvVar("name",faker.string.alphanumeric({ length: { min: 5, max: 10 } }));
  
}

tests {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
}
