FROM node:18-alpine AS builder
WORKDIR /app
COPY ./back/quiz_wonders .
RUN rm -r deploy/
RUN npm install
RUN npm install -D esbuild && npm run build

FROM node:18-alpine
WORKDIR /app
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/package.json ./

RUN npm install --omit=dev && npm cache clean --force

RUN mkdir config/
RUN echo '{"development":{"username":"gpebackquizzuser","password":"e5JjB4wmYCf5OXps191fjH7qWuafGrZS","database":"gpebackquizz","host":"163.5.107.36","port":"5432","dialect":"postgres"}}' > ./config/config.json
RUN echo -e 'DB_NAME=gpebackquizz \nDB_USER=gpebackquizzuser \nDB_PASSWORD=e5JjB4wmYCf5OXps191fjH7qWuafGrZS \nDB_HOST=163.5.107.36 \nDB_DIALECT=postgres \nJWT_SECRET_KEY=1223456789abcdef \nPORT=3001' > .env
RUN cat .env
CMD ["node", "dist/index.js"]
