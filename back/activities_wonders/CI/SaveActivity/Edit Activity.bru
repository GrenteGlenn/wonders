meta {
  name: Edit Activity
  type: http
  seq: 4
}

put {
  url: {{base_url}}/activity/{{activityid}}
  body: json
  auth: inherit
}

body:json {
  {
    "url": "https://www.exemple2.fr/",
    "name": "{{activityname}}",
    "description": "{{activitydescription}}",
    "is_free": false,
    "duration": 10,
    "partner": "owner",
    "price": 180.09,
    "category_id": 6
  }
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  bru.setEnvVar("activityname",faker.company.name());
  bru.setEnvVar("activitydescription",faker.company.name());
}

tests {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
}
