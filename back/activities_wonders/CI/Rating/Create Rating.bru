meta {
  name: Create Rating
  type: http
  seq: 2
}

post {
  url: {{base_url}}/rating/
  body: json
  auth: inherit
}

body:json {
  {
    "rating": 2
  }
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  bru.setEnvVar("category",faker.lorem.word())
  
}

tests {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  const response = res.getBody();
  
  bru.setEnvVar("ratingid", response.id);
}
