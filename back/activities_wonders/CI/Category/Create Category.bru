meta {
  name: Create Category
  type: http
  seq: 2
}

post {
  url: {{base_url}}/activity-category/
  body: json
  auth: inherit
}

body:json {
  {
    "picture_id": 1,
    "name": "{{category}}"
  }
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  bru.setEnvVar("category",faker.lorem.word())
  
}

tests {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  const response = res.getBody();
  
  bru.setEnvVar("categoryid", response.id);
}
