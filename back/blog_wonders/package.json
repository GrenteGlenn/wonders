{
  "name": "blog_wonders",
  "version": "1.0.0",
  "description": " Micro service qui gère les blog de l'application wonder",
  "main": "app.ts",
  "scripts": {
    "start": "ts-node src/app.ts",
    "migration:run": "npx sequelize-cli db:migrate",
    "migration:seeder": "npx sequelize-cli db:seed:all",
    "migration:undo:all": "npx sequelize-cli db:migrate:undo:all",
    "lint": "eslint src/**/*.ts",
    "format": "eslint src/**/*.ts --fix",
    "test": "jest"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@sequelize/postgres": "^7.0.0-alpha.41",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.8",
    "@types/sequelize": "^4.28.20",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "eslint": "^8",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.3.2",
    "sequelize-cli": "^6.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "typescript-eslint": "^7.16.0"
  }
}
