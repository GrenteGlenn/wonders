meta {
  name: Post City
  type: http
  seq: 2
}

post {
  url: {{base_url}}/cities
  body: json
  auth: none
}

body:json {
  {
      "name": "{{cityname}}",
      "country": 1
  }
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  bru.setEnvVar("cityname",faker.lorem.word())
}

tests {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  const response = res.getBody();
  
  bru.setEnvVar("cityid", response.id);
}
