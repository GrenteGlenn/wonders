meta {
  name: Create Langague
  type: http
  seq: 2
}

post {
  url: {{base_url}}/languages/
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenAdmin}}
}

body:json {
  {
      "name": "{{languagename}}",
      "code": "TS"
  }
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  bru.setEnvVar("languagename",faker.lorem.word())
}

tests {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  const response = res.getBody();
  
  bru.setEnvVar("languageid", response.id);
}
