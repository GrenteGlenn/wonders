meta {
  name: Get Address User Id
  type: http
  seq: 3
}

get {
  url: {{base_url}}/address/user/{{userId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  const response = res.getBody();
  
  bru.setEnvVar("addressid", response[0].id);
}
