meta {
  name: Update Address
  type: http
  seq: 6
}

put {
  url: {{address}}api/address/{{addressid}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "{{StreetName}}",
    "street": "{{StreetAddress}}",
    "city": "{{City}}",
    "zip_code": "{{CountryCode}}",
    "complementary": "",
    "country_id": 1,
    "user_id": {{userId}}
  }
}

script:pre-request {
  // bru.setGlobalEnvVar("StreetName", pm.variables.replaceIn("{{$randomStreetName}}"));
  
}

tests {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
}
