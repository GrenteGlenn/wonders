meta {
  name: Register Address
  type: http
  seq: 1
}

post {
  url: http://{{address}}/api/address/register
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "{{StreetName}}",
    "street": "{{StreetAddress}}",
    "city": "{{City}}",
    "zip_code": "{{CountryCode}}",
    "complementary": "",
    "country_id": 1,
    "user_id": {{userId}}
  }
}

script:pre-request {
