meta {
  name: Register Address
  type: http
  seq: 1
}

post {
  url: {{base_url}}/address/register
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "{{StreetName}}",
    "street": "{{StreetAddress}}",
    "city": "{{City}}",
    "zip_code": "{{CountryCode}}",
    "complementary": "",
    "country_id": 1,
    "user_id": {{userId}}
  }
}

script:pre-request {
  const { faker } = require('@faker-js/faker');
  
  bru.setEnvVar("StreetName", faker.location.street());
  bru.setEnvVar("StreetAddress", faker.location.streetAddress());
  bru.setEnvVar("City", faker.location.city());
  bru.setEnvVar("CountryCode", faker.location.countryCode());
}

tests {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
}
