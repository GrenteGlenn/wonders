meta {
  name: Send Mail
  type: http
  seq: 4
}

get {
  url: {{address}}api/auth/send_mail
  body: json
  auth: none
}

body:json {
  {
      "email": "{{Mail}}"
  }
}

tests {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  const response = res.getBody();
  
  bru.setGlobalEnvVar("refresh_token", response.token);
}
