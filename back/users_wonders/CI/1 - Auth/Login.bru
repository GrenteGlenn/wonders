meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{address}}api/auth/login
  body: json
  auth: none
}

body:json {
  {
      "email": "{{Mail}}",
      "password": "{{Password}}"
  }
}

tests {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
  
  const response = res.getBody();
  
  bru.setEnvVar("token", response.data.token);
  bru.setEnvVar("userId", response.data.userId);
}
