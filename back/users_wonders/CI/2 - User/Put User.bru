meta {
  name: Put User
  type: http
  seq: 3
}

put {
  url: http://{{address}}/api/users/{{userId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
      "first_name": "John",
      "last_name": "Doe",
      "email": "{{Mail}}",
      "birth_date": "2024-07-19T00:22:05.916Z",
      "language_id": 1,
      "country_id": 1
  }
}

tests {
  test("Status code is 200", function () {
      expect(res.getStatus()).to.equal(200);
  });
}
